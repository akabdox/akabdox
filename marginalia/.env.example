# Supabase project (Settings > API). Legacy anon / service_role keys also work.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server only. Used by the payment webhook and checkout bookkeeping. Never expose.
SUPABASE_SECRET_KEY=sb_secret_...

# Public URL of the site, used for auth emails and payment redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Payments. Leave CHARGILY_SECRET_KEY empty to run in manual mode:
# orders are placed, buyers pay by transfer or cash, the admin confirms.
CHARGILY_SECRET_KEY=
# test | live
CHARGILY_MODE=test
